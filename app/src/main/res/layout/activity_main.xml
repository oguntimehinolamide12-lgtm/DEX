<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dexBg">

    <!-- ============================ TOP DECK ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_bar">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:contentDescription="DEX" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="DEX"
            style="@style/DexTitle"
            android:textSize="15sp"
            android:letterSpacing="0.28" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/dexLine" />

        <TextView
            android:id="@+id/tvContext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/DexLabel"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="no file" />

        <View
            android:id="@+id/pulseDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/ember" />

        <TextView
            android:id="@+id/tvAgentState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDLE"
            style="@style/DexLabel"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/DexKey"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:tint="?attr/dexMuted"
            android:contentDescription="Menu" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dexAccent"
        android:alpha="0.5" />

    <!-- ============================== BODY =============================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- rail -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_bar"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView android:id="@+id/railFiles" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_files" android:paddingTop="11dp" android:contentDescription="Files" />
            <TextView android:id="@+id/railEditor" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_editor" android:paddingTop="11dp" android:contentDescription="Editor" />
            <TextView android:id="@+id/railBrowser" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_browser" android:paddingTop="11dp" android:contentDescription="Browser" />
            <TextView android:id="@+id/railTerminal" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_terminal" android:paddingTop="11dp" android:contentDescription="Terminal" />
            <TextView android:id="@+id/railCloud" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_cloud" android:paddingTop="11dp" android:contentDescription="Cloud" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/dexLine" />

            <View
                android:layout_width="16dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="?attr/dexAccent"
                android:alpha="0.25" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView android:id="@+id/railAgent" style="@style/DexRailKey" android:layout_width="match_parent" android:layout_height="46dp" android:text="" android:drawableTop="@drawable/ic_nav_agent" android:paddingTop="11dp" android:contentDescription="Agent" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/dexLine" />

        <!-- files column -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="196dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FILES"
                    style="@style/DexLabel"
                    android:textColor="?attr/dexText" />

                <ImageButton android:id="@+id/btnOpenFolder" style="@style/DexKey" android:layout_width="28dp" android:layout_height="24dp" android:src="@drawable/ic_folder_open" android:scaleType="centerInside" android:padding="4dp" android:tint="?attr/dexMuted" android:contentDescription="Open folder" />
                <ImageButton android:id="@+id/btnNewFile" style="@style/DexKey" android:layout_width="28dp" android:layout_height="24dp" android:layout_marginStart="3dp" android:src="@drawable/ic_add" android:scaleType="centerInside" android:padding="4dp" android:tint="?attr/dexMuted" android:contentDescription="New file" />
                <ImageButton android:id="@+id/btnRecent" style="@style/DexKey" android:layout_width="28dp" android:layout_height="24dp" android:layout_marginStart="3dp" android:src="@drawable/ic_history" android:scaleType="centerInside" android:padding="4dp" android:tint="?attr/dexMuted" android:contentDescription="Recent" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/dexLine" />

            <EditText
                android:id="@+id/etFileSearch"
                style="@style/DexInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:hint="filter"
                android:singleLine="true"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fileRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <View
            android:id="@+id/sidebarRule"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/dexLine"
            android:visibility="gone" />

        <!-- panes -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/editorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/browserContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/terminalContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/cloudContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/splitter"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="?attr/dexBg" />

        <!-- agent -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/dexContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
