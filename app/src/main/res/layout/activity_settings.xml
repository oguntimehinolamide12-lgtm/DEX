<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dexBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEX / CONFIG"
            style="@style/DexTitle"
            android:textSize="15sp"
            android:letterSpacing="0.28"
            android:textColor="?attr/dexAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="model provider, skin, agent limits, browser home"
            style="@style/DexLabel" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="?attr/dexLine" />

        <!-- provider -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="MODEL PROVIDER" style="@style/DexLabel" android:textColor="?attr/dexText" />
        <Spinner android:id="@+id/spinPreset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <Spinner android:id="@+id/spinProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

        <EditText android:id="@+id/etModel" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="model (gpt-4o-mini)" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <EditText android:id="@+id/etBaseUrl" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="base url (optional)" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="OPENAI KEY" style="@style/DexLabel" />
        <EditText android:id="@+id/etOpenAi" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="ANTHROPIC KEY" style="@style/DexLabel" />
        <EditText android:id="@+id/etAnthropic" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="GEMINI KEY" style="@style/DexLabel" />
        <EditText android:id="@+id/etGemini" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="COMPATIBLE / CUSTOM KEY" style="@style/DexLabel" />
        <EditText android:id="@+id/etCustom" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:inputType="textPassword" android:hint="not needed for local ollama" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="?attr/dexLine" />

        <!-- skin -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="SKIN" style="@style/DexLabel" android:textColor="?attr/dexText" />
        <Spinner android:id="@+id/spinTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <Spinner android:id="@+id/spinFont" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/etFontSize" style="@style/DexInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="font size" />
            <EditText android:id="@+id/etTabSize" style="@style/DexInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:inputType="number" android:hint="tab size" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="?attr/dexLine" />

        <!-- agent + browser -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="AGENT + BROWSER" style="@style/DexLabel" android:textColor="?attr/dexText" />

        <EditText android:id="@+id/etBrowserHome" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textUri" android:hint="browser home url" />
        <EditText android:id="@+id/etAgentSteps" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="number" android:hint="agent tool steps per request" />

        <CheckBox
            android:id="@+id/cbFileAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="agent may read/write files and run code"
            android:buttonTint="?attr/dexAccent"
            android:textColor="?attr/dexText"
            android:textSize="12sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="?attr/dexLine" />

        <!-- profiles -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="SAVED PROFILES" style="@style/DexLabel" android:textColor="?attr/dexText" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="center_vertical">
            <Spinner android:id="@+id/spinProfile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <Button android:id="@+id/btnProfileLoad" style="@style/DexKey" android:layout_width="wrap_content" android:layout_height="26dp" android:layout_marginStart="6dp" android:text="LOAD" />
        </LinearLayout>

        <EditText android:id="@+id/etProfileName" style="@style/DexInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="profile name" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnProfileSave" style="@style/DexKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:text="SAVE AS" />
            <Button android:id="@+id/btnProfileDelete" style="@style/DexKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:layout_marginStart="6dp" android:text="DELETE" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:layout_marginBottom="12dp">
            <Button android:id="@+id/btnTest" style="@style/DexKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="TEST" />
            <Button android:id="@+id/btnSave" style="@style/DexKeyAccent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="8dp" android:text="SAVE" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
