<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dexBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEX"
            style="@style/DexTitle"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textColor="?attr/dexAccent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="AGENT"
            style="@style/DexLabel"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnStop"
            style="@style/DexKey"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="STOP"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClear"
            style="@style/DexKey"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:text="CLR" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dexLine" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dexLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="6dp"
        android:background="@drawable/bg_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="8dp"
            android:text="▸"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="?attr/dexAccent" />

        <EditText
            android:id="@+id/inputMessage"
            style="@style/DexInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="tell dex what to build"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnSend"
            style="@style/DexKeyAccent"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="5dp"
            android:text="↵"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
