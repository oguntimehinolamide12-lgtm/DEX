<resources>
    <style name="Theme.VibeCode" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Theme.VibeCode.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#007acc</item>
        <item name="colorPrimaryVariant">#e0e0e0</item>
        <item name="colorAccent">#007acc</item>
        <item name="android:windowBackground">#f5f5f5</item>
        <item name="android:textColor">#1e1e1e</item>
    </style>
    <style name="Theme.VibeCode.HighContrast" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#00ffff</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorAccent">#ffff00</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColor">#ffffff</item>
    </style>
    <style name="Theme.VibeCode.Monokai" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#a6e22e</item>
        <item name="colorPrimaryVariant">#272822</item>
        <item name="colorAccent">#f92672</item>
        <item name="android:windowBackground">#272822</item>
        <item name="android:textColor">#f8f8f2</item>
    </style>
</resources>
